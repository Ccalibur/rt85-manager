<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Ccalibur.Rt85Manager</id>
  <name>RT85 Manager</name>
  <summary>Configure the Epomaker RT85 keyboard</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.ccalibur">
    <name>Ccalibur</name>
  </developer>
  <description>
    <p>
      RT85 Manager configures the Epomaker RT85 mechanical keyboard on Linux, with a
      native COSMIC interface.
    </p>
    <ul>
      <li>Built-in lighting effects: mode, speed, brightness, direction and colour</li>
      <li>Per-key RGB colours on a clickable keyboard layout</li>
      <li>Key remapping</li>
      <li>Upload images and animated GIFs to the built-in screen</li>
      <li>Clock sync and live CPU usage and temperature on the screen</li>
    </ul>
    <p>
      The keyboard protocol is reverse-engineered and support is experimental.
    </p>
  </description>
  <launchable type="desktop-id">io.github.Ccalibur.Rt85Manager.desktop</launchable>
  <url type="homepage">https://github.com/Ccalibur/rt85-manager</url>
  <url type="bugtracker">https://github.com/Ccalibur/rt85-manager/issues</url>
  <categories>
    <category>Settings</category>
    <category>HardwareSettings</category>
  </categories>
  <provides>
    <binary>rt85-manager</binary>
    <binary>rt85</binary>
  </provides>
  <requires>
    <display_length compare="ge">640</display_length>
  </requires>
  <supports>
    <control>pointing</control>
    <control>keyboard</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <caption>Lighting effects</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/lighting.png</image>
    </screenshot>
    <screenshot>
      <caption>Per-key colours on the RT85 layout</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/keys.png</image>
    </screenshot>
    <screenshot>
      <caption>Macros on any key</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/macros.png</image>
    </screenshot>
    <screenshot>
      <caption>Screen image upload and widgets</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/screen.png</image>
    </screenshot>
    <screenshot>
      <caption>Connected keyboard details</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/device.png</image>
    </screenshot>
    <screenshot>
      <caption>Settings: layout, colour scheme and frosted glass</caption>
      <image>https://raw.githubusercontent.com/Ccalibur/rt85-manager/main/docs/screenshots/settings.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="0.2.0" date="2026-11-03">
      <description>
        <p>Macros, live screen content, RT85 75% layout and desktop integration.</p>
        <ul>
          <li>Macros: key, text and delay steps on any key, played by the app while it runs</li>
          <li>Live screen: now-playing media with cover art and time bar, game FPS from MangoHud</li>
          <li>RT85 75% board in US ANSI or UK ISO, with square keycaps</li>
          <li>Settings: follow the COSMIC theme or KDE colour scheme, frosted glass</li>
          <li>Window controls now show on KDE and GNOME</li>
        </ul>
      </description>
    </release>
    <release version="0.1.0" date="2026-11-02">
      <description>
        <p>First release: lighting, per-key colours, remapping, screen upload and widgets.</p>
      </description>
    </release>
  </releases>
</component>
